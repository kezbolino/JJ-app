{
  "name": "JJ-app",
  "short_name": "JJ",
  "description": "A personal knowledge system for jiu-jitsu.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f7fc",
  "theme_color": "#f5f7fc",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Log a class",
      "short_name": "Log",
      "description": "Write up the session you just trained",
      "url": "./#/log",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Round timer",
      "short_name": "Timer",
      "description": "Rounds and rest, with a beep",
      "url": "./#/timer",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Drill flashcards",
      "short_name": "Drill",
      "description": "Review the cards that are due",
      "url": "./#/focus",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
